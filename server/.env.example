MONGODB_URI=
CLERK_WEBHOOK_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI Study Assistant (Gemini) ─────────────────────────────────────────────
# Required for /api/ai/chat. Without it the assistant is disabled and the rest
# of the app keeps working normally.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash.
# Note: gemini-2.5-flash is rejected ("no longer available to new users") for
# API keys created after its deprecation.
GEMINI_MODEL=gemini-3.5-flash

# Optional comma-separated frontend origins in addition to the built-in
# localhost and production VidyaTrack origins.
CORS_ORIGINS=
