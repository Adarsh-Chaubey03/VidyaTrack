{
    "version": 2,
    "functions": {
        "server.js": {
            "runtime": "@vercel/node@3",
            "memory": 1024,
            "maxDuration": 15
        }
    },
    "routes": [
        { "src": "/api/(.*)", "dest": "server.js" },
        { "src": "/(.*)", "dest": "server.js" }
    ]
}